  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourceDesafio">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=Desafio3</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>ab015b0b-d2a5-428f-af2b-1db8fa0efc92</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSourceDesafio</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@TiempoPreparacion">
            <Value>=Parameters!TiempoPreparacion.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  r.NombreReceta,
  r.TiempoPreparacion,
  i.NombreIngrediente,
  i.CantidadIngrediente,
  i.UnidadMedida
FROM Recetas r
INNER JOIN Ingredientes i ON r.Id = i.RecetaID
WHERE r.TiempoPreparacion LIKE '%' + @TiempoPreparacion + '%'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NombreReceta">
          <DataField>NombreReceta</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TiempoPreparacion">
          <DataField>TiempoPreparacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NombreIngrediente">
          <DataField>NombreIngrediente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CantidadIngrediente">
          <DataField>CantidadIngrediente</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="UnidadMedida">
          <DataField>UnidadMedida</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
