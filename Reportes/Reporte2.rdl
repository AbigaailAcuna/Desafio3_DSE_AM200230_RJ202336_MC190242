  <DataSources>
    <DataSource Name="DataSourceDesafio3">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=Desafio3</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>fe8d2631-9e16-49ac-94b0-7f3a787e3055</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSourceDesafio3</DataSourceName>
        <CommandText>SELECT 
   r.NombreReceta,
   p.DescripcionPaso,
   p.OrdenPaso
FROM Recetas r
INNER JOIN
    Preparaciones p ON r.Id = p.RecetaID
ORDER BY
    r.NombreReceta, p.OrdenPaso</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NombreReceta">
          <DataField>NombreReceta</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DescripcionPaso">
          <DataField>DescripcionPaso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrdenPaso">
          <DataField>OrdenPaso</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
